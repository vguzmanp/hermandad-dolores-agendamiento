# Copia este archivo como .env y ajusta los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Santiago

# --- Base de datos ---
# sqlite (temporal) o postgres
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Solo si DB_ENGINE=postgres
DB_NAME=hermandad_dolores
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Archivos subidos (documentos de pacientes) ---
MEDIA_DIR=media

# --- Reglas del dominio ---
CITA_DIAS_AVISO_DEFECTO=2
AGENDA_SEMANAS_GENERACION=4
